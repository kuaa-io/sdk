// Client talks to KUAA's API with one organization's API key. The key says
// the organization and the environment: kuaa_<prefix>_<secret> is live,
// kuaa_test_<prefix>_<secret> the organization's sandbox.
type Client struct {
	apiKey  string
	baseURL string
	http    *http.Client
	last    atomic.Pointer[Response]
{{- range .Services}}
	{{pascal .Name}} *{{pascal .Name}}Service
{{- end}}
}

// Option configures a Client.
type Option func(*Client)

// WithBaseURL points the client at another address, such as a local server.
func WithBaseURL(baseURL string) Option {
	return func(c *Client) { c.baseURL = strings.TrimRight(baseURL, "/") }
}

// WithHTTPClient sends the requests through httpClient.
func WithHTTPClient(httpClient *http.Client) Option {
	return func(c *Client) { c.http = httpClient }
}

// New is a client for the organization apiKey belongs to.
func New(apiKey string, opts ...Option) *Client {
	c := &Client{apiKey: apiKey, baseURL: DefaultBaseURL, http: &http.Client{Timeout: 30 * time.Second}}
	for _, opt := range opts {
		opt(c)
	}
	c.initServices()
	return c
}

// Response is what the API said about the last answer, beside its body.
type Response struct {
	StatusCode int
	// Livemode is the Kuaa-Livemode header: true for live, false for a
	// sandbox, nil when the answer did not carry it.
	Livemode *bool
	// Environment is the Kuaa-Environment header: live or sandbox.
	Environment string
	// IdempotentReplayed says the answer is the stored answer of an earlier
	// request with the same Idempotency-Key.
	IdempotentReplayed bool
	// RequestID is the X-Request-ID header.
	RequestID string
}

// LastResponse is what the API said about the last answer this client read,
// or nil before the first one. A client shared between goroutines reads
// whichever answer came last.
func (c *Client) LastResponse() *Response { return c.last.Load() }

// RequestOption configures one call.
type RequestOption func(*requestConfig)

type requestConfig struct {
	idempotencyKey string
	apiKey         string
}

// WithIdempotencyKey makes a write safe to repeat: the same key with the same
// request answers the first response again; with another request, a 409.
func WithIdempotencyKey(key string) RequestOption {
	return func(r *requestConfig) { r.idempotencyKey = key }
}

// WithAPIKey sends this call with another organization's key.
func WithAPIKey(key string) RequestOption {
	return func(r *requestConfig) { r.apiKey = key }
}

// Ptr is a pointer to v, for the optional fields of a request.
func Ptr[T any](v T) *T { return &v }

// File is one file of a multipart body.
type File struct {
	// Filename is the name the part carries, such as frente.jpg.
	Filename string
	// ContentType is the file's media type: image/jpeg or image/png.
	ContentType string
	Data        []byte
}

// part is one field of a multipart body: a value, or a file.
type part struct {
	name  string
	value string
	file  *File
}

func textPart(name, value string) part { return part{name: name, value: value} }

func filePart(name string, file File) part { return part{name: name, file: &file} }

// encodeMultipart writes parts as multipart/form-data.
func encodeMultipart(parts []part) ([]byte, string, error) {
	var buf bytes.Buffer
	writer := multipart.NewWriter(&buf)
	var seed [12]byte
	if _, err := rand.Read(seed[:]); err != nil {
		return nil, "", err
	}
	if err := writer.SetBoundary("kuaa-" + hex.EncodeToString(seed[:])); err != nil {
		return nil, "", err
	}
	for _, p := range parts {
		if p.file == nil {
			if err := writer.WriteField(p.name, p.value); err != nil {
				return nil, "", err
			}
			continue
		}
		header := textproto.MIMEHeader{}
		header.Set("Content-Disposition", fmt.Sprintf(`form-data; name="%s"; filename="%s"`, escapeQuotes(p.name), escapeQuotes(p.file.Filename)))
		contentType := p.file.ContentType
		if contentType == "" {
			contentType = "application/octet-stream"
		}
		header.Set("Content-Type", contentType)
		w, err := writer.CreatePart(header)
		if err != nil {
			return nil, "", err
		}
		if _, err := w.Write(p.file.Data); err != nil {
			return nil, "", err
		}
	}
	if err := writer.Close(); err != nil {
		return nil, "", err
	}
	return buf.Bytes(), writer.FormDataContentType(), nil
}

var quoteEscaper = strings.NewReplacer(`\`, `\\`, `"`, `\"`, "\r", "%0D", "\n", "%0A")

func escapeQuotes(s string) string { return quoteEscaper.Replace(s) }

// envelope is how the API wraps what it answers.
type envelope struct {
	Data json.RawMessage `json:"data"`
	Meta struct {
		NextCursor *string `json:"next_cursor"`
		HasMore    *bool   `json:"has_more"`
	} `json:"meta"`
}

func (c *Client) do(ctx context.Context, method, path string, query url.Values, body any, parts []part, opts []RequestOption) (*envelope, error) {
	config := requestConfig{apiKey: c.apiKey}
	for _, opt := range opts {
		opt(&config)
	}
	target := c.baseURL + path
	if len(query) > 0 {
		target += "?" + query.Encode()
	}
	var reader io.Reader
	contentType := ""
	switch {
	case parts != nil:
		encoded, formType, err := encodeMultipart(parts)
		if err != nil {
			return nil, err
		}
		reader, contentType = bytes.NewReader(encoded), formType
	case body != nil:
		encoded, err := json.Marshal(body)
		if err != nil {
			return nil, err
		}
		reader, contentType = bytes.NewReader(encoded), "application/json"
	}
	req, err := http.NewRequestWithContext(ctx, method, target, reader)
	if err != nil {
		return nil, err
	}
	req.Header.Set("Authorization", "Bearer "+config.apiKey)
	req.Header.Set("Accept", "application/json")
	req.Header.Set("User-Agent", "kuaa-go/"+Version)
	if contentType != "" {
		req.Header.Set("Content-Type", contentType)
	}
	if config.idempotencyKey != "" {
		req.Header.Set("Idempotency-Key", config.idempotencyKey)
	}
	resp, err := c.http.Do(req)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()
	raw, err := io.ReadAll(resp.Body)
	if err != nil {
		return nil, err
	}
	c.last.Store(responseOf(resp))
	if resp.StatusCode >= 300 {
		return nil, errorOf(resp, raw)
	}
	var out envelope
	if err := json.Unmarshal(raw, &out); err != nil {
		return nil, fmt.Errorf("kuaa: read the answer to %s %s: %w", method, path, err)
	}
	return &out, nil
}

// call answers the data of one call, decoded into out.
func (c *Client) call(ctx context.Context, method, path string, query url.Values, body any, parts []part, out any, opts []RequestOption) error {
	answer, err := c.do(ctx, method, path, query, body, parts, opts)
	if err != nil {
		return err
	}
	return json.Unmarshal(answer.Data, out)
}

// page answers one page of a list, its items under field.
func page[T any](ctx context.Context, c *Client, path string, query url.Values, field string, opts []RequestOption) (*Page[T], error) {
	answer, err := c.do(ctx, http.MethodGet, path, query, nil, nil, opts)
	if err != nil {
		return nil, err
	}
	var data map[string]json.RawMessage
	if err := json.Unmarshal(answer.Data, &data); err != nil {
		return nil, err
	}
	out := &Page[T]{NextCursor: answer.Meta.NextCursor}
	if raw, ok := data[field]; ok {
		if err := json.Unmarshal(raw, &out.Items); err != nil {
			return nil, err
		}
	}
	if answer.Meta.HasMore != nil {
		out.HasMore = *answer.Meta.HasMore
	} else {
		out.HasMore = out.NextCursor != nil && *out.NextCursor != ""
	}
	return out, nil
}

func responseOf(resp *http.Response) *Response {
	out := &Response{
		StatusCode:         resp.StatusCode,
		Environment:        resp.Header.Get("Kuaa-Environment"),
		IdempotentReplayed: resp.Header.Get("Idempotent-Replayed") == "true",
		RequestID:          resp.Header.Get("X-Request-ID"),
	}
	switch resp.Header.Get("Kuaa-Livemode") {
	case "true":
		out.Livemode = Ptr(true)
	case "false":
		out.Livemode = Ptr(false)
	}
	return out
}

func errorOf(resp *http.Response, raw []byte) *Error {
	e := &Error{StatusCode: resp.StatusCode, RequestID: resp.Header.Get("X-Request-ID")}
	var body struct {
		Error struct {
			Code    string              `json:"code"`
			Message string              `json:"message"`
			Fields  map[string][]string `json:"fields"`
		} `json:"error"`
	}
	if json.Unmarshal(raw, &body) == nil {
		e.Code, e.Message, e.Fields = body.Error.Code, body.Error.Message, body.Error.Fields
	}
	if e.Fields == nil {
		e.Fields = map[string][]string{}
	}
	if seconds, err := strconv.Atoi(strings.TrimSpace(resp.Header.Get("Retry-After"))); err == nil && seconds >= 0 {
		e.RetryAfter = time.Duration(seconds) * time.Second
	}
	return e
}
