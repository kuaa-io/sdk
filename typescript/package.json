{
  "name": "@kuaa-io/sdk",
  "version": "0.2.0",
  "description": "KUAA's SDK for TypeScript and JavaScript: identity verification cases (KYC, KYB, age), parties, captures, decisions, dossiers and webhooks.",
  "license": "MIT",
  "homepage": "https://kuaa.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuaa-io/sdk.git",
    "directory": "typescript"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
